# Configure these variables in the hosting provider's secret/environment panel.
NODE_ENV=production
# Render provides PORT automatically; locally the API defaults to 3001.
DB_HOST=your-managed-mysql-host
DB_PORT=4000
DB_USER=your-database-user
DB_PASSWORD=replace-with-a-secret
DB_NAME=carrinha_escolar
DB_SSL=true
# Optional PEM certificate content. TiDB Cloud Starter trusts Node's built-in
# CA bundle, so do not set this to a local file path.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Comma-separated browser origins if a web frontend is hosted separately.
# The Android app origin https://localhost is already allowed by the API.
CORS_ORIGINS=https://your-web-app.example
